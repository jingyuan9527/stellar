# =============================================================================
# Stellar 部署环境变量模板
# -----------------------------------------------------------------------------
# 用法：复制本文件为 .env 并按实际填写，docker-compose 会自动加载 .env
#   cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，切勿提交真实凭证。
# =============================================================================

# ---------- 数据库（外部 PostgreSQL，需提前建库并初始化表结构）----------
# JDBC 连接串，形如 jdbc:postgresql://<host>:<port>/<database>
DB_URL=jdbc:postgresql://localhost:5432/soybean
DB_USERNAME=postgres
DB_PASSWORD=postgres

# ---------- Redis（缓存/会话/限流，外置实例）----------
# Redis 连接串，形如 redis://:password@host:port（不带末尾 /db，db 由 REDIS_DATABASE 指定）
# 留空则不启用 Redis
# 启用后：Sa-Token 会话持久化、IP 限流多实例共享、Spring Cache 业务缓存
REDIS_URL=
# Redis db（用于隔离不同应用数据，本项目用 1）
# 注意：url 末尾 /db 在某些 Spring Boot 版本不被 Lettuce 解析（会落到 db0），必须用此变量显式指定
REDIS_DATABASE=1

# ---------- 后端 ----------
# Spring profile：default（默认，不自动执行 schema.sql）；如需启动建表请走应用层 profile 配置
SPRING_PROFILES_ACTIVE=default
# IP 单日限流阈值（游客调用耗资源接口的次数上限）
RATE_LIMIT_DAILY=50

# ---------- 端口映射（宿主机端口）----------
# 单容器对外端口（Nginx 托管前端 + 反代后端）
FRONTEND_PORT=80
